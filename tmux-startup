#!/usr/bin/env python3
"""Create tmux sessions, windows and panes from a JSON layout config.

Everything machine-, client- or project-specific (session names, repo paths,
commands to run) lives in the config file, so this script carries no private
data and can be committed. Python 3 standard library only.

Config: ${XDG_CONFIG_HOME:-~/.config}/tmux-startup/config.json
        (override with $TMUX_STARTUP_CONFIG or --config)
Hooks:  <config dir>/hooks/pre/*, <config dir>/hooks/post/*

Get started with:
    mkdir -p ~/.config/tmux-startup
    tmux-startup --example > ~/.config/tmux-startup/config.json
"""

import argparse
import json
import os
import shlex
import shutil
import socket
import subprocess
import sys

PROG = "tmux-startup"

