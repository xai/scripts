def resolve(requested, sessions, settings):
    """Map command-line names onto configured sessions, in the given order."""
    by_name = {}
    for session in sessions:
        for alias in [session["name"], *session["aliases"]]:
            by_name[alias] = session
    resolved, unknown = [], []
    for name in requested:
        session = by_name.get(name)
        if session is not None:
            if session not in resolved:
                resolved.append(session)
            continue
        if settings["unknown_sessions"] == "create":
            resolved.append({
                "where": "<command line>", "name": name, "aliases": [], "autostart": False,
                "server": settings["server"], "path": os.path.expanduser(settings["default_path"]),
                "windows": [], "select": 1,
            })
        else:
            unknown.append(name)
    return resolved, unknown


def list_sessions(sessions, servers):
    if not sessions:
        info("No sessions configured.")
        return
    running = {}
    width = max(len(s["name"]) for s in sessions)
    for session in sessions:
        tmux = servers[session["server"]]
        if tmux.name not in running:
            running[tmux.name] = tmux.session_names() if tmux.is_running() else []
        marks = []
        if session["name"] in running[tmux.name]:
            marks.append("running")
        if session["autostart"]:
            marks.append("autostart")
        if session["aliases"]:
            marks.append("aka " + ", ".join(session["aliases"]))
        if session["server"] != "default":
            marks.append(f"server {session['server']}")
        windows = len(session["windows"])
        detail = f"{windows} window{'s' if windows != 1 else ''}" if windows else "default window"
        if marks:
            detail += " [" + "; ".join(marks) + "]"
        info(f"  {session['name']:<{width}}  {detail}")


def main(argv=None):
    parser = argparse.ArgumentParser(
        prog=PROG,
        description="Create tmux sessions, windows and panes from a JSON layout config.",
        epilog=EPILOG,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument("sessions", nargs="*", metavar="SESSION",
                        help="configured session names (or aliases) to start")
    parser.add_argument("-c", "--config", metavar="PATH", help="config file to use")
    parser.add_argument("-l", "--list", action="store_true", help="list configured sessions and exit")
    parser.add_argument("--names", action="store_true",
                        help="print session names and aliases, one per line (for shell completion)")
    parser.add_argument("--all", action="store_true",
                        help="start every session marked \"autostart\"")
    parser.add_argument("-a", "--attach", action="store_true",
                        help="attach to the first requested session when done")
    parser.add_argument("-n", "--dry-run", action="store_true",
                        help="print the tmux commands instead of running them")
    parser.add_argument("--example", action="store_true",
                        help="print a starter config on stdout and exit")
    args = parser.parse_args(argv)

    if args.example:
        sys.stdout.write(EXAMPLE_CONFIG)
        return 0

    if shutil.which("tmux") is None:
        print(f"{PROG}: error: tmux is not installed", file=sys.stderr)
        return 1

    path = config_path(args.config)
    try:
        settings, sessions = parse_config(load_config(path), path)
    except ConfigError as exc:
        print(f"{PROG}: error: {exc}", file=sys.stderr)
        return 1

    if args.names:
        for session in sessions:
            for name in [session["name"], *session["aliases"]]:
                print(name)
        return 0

    servers = {name: Tmux(name, spec, args.dry_run)
               for name, spec in settings["servers"].items()}

    if args.list:
        list_sessions(sessions, servers)
        return 0

    requested = list(args.sessions)
    selected, unknown = resolve(requested, sessions, settings)
    if args.all:
        for session in sessions:
            if session["autostart"] and session not in selected:
                selected.append(session)

    if unknown:
        known = ", ".join(sorted(n for s in sessions for n in [s["name"], *s["aliases"]])) or "none"
        for name in unknown:
            print(f"{PROG}: error: no session named {name!r} in {path}", file=sys.stderr)
        print(f"       configured: {known}", file=sys.stderr)
        print(f'       set defaults.unknown_sessions to "create" to open plain sessions instead',
              file=sys.stderr)
        return 1

    if not selected:
        if not requested:
            parser.print_usage(sys.stderr)
            print(f"{PROG}: error: name a session, or use --all or --list", file=sys.stderr)
            return 1
        return 0

    names = [session["name"] for session in selected]
    run_hooks(settings["hooks"], "pre", names, path, args.dry_run)

    failed = False
    for session in selected:
        try:
            if not start_session(session, servers, args.dry_run):
                failed = True
        except TmuxError as exc:
            warn(f'session "{session["name"]}": {exc}')
            failed = True

    run_hooks(settings["hooks"], "post", names, path, args.dry_run)

    if args.attach:
        first = selected[0]
        attach(servers[first["server"]], first["name"], args.dry_run)

    return 1 if failed else 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(130)
